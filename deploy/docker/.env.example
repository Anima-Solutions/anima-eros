# Copie para .env (mesma pasta) e ajuste. O .env é ignorado pelo git.

# --- Imagem / container -------------------------------------------------------
COMPOSE_PROJECT_NAME=hermes-anima
HERMES_IMAGE=hermes-agent:anima
HERMES_CONTAINER_NAME=hermes-anima

# Pasta do host montada em /opt/data (config.yaml, .env de chaves, sessões, logs).
HERMES_DATA_DIR=./data
# Dono dessa pasta no host: rode `id -u` e `id -g`.
HERMES_UID=1000
HERMES_GID=1000

# --- Portas -------------------------------------------------------------------
# *_PORT       = porta dentro do container (é a que você informa ao NPM)
# *_HOST_PORT  = porta publicada no host
# HOST_BIND_IP = 127.0.0.1 só na máquina; 0.0.0.0 abre para a rede (evite no VPS)
HOST_BIND_IP=127.0.0.1
DASHBOARD_PORT=9119
DASHBOARD_HOST_PORT=9119
API_SERVER_PORT=8642
API_SERVER_HOST_PORT=8642
# Webapp: WEBAPP_PORT tem de ser igual a webapp.port em data/config.yaml
WEBAPP_PORT=9120
WEBAPP_HOST_PORT=9120

# --- Rede compartilhada com o Nginx Proxy Manager -----------------------------
HERMES_NETWORK=hermes-net
HERMES_SUBNET=172.30.0.0/24

# --- Dashboard ----------------------------------------------------------------
# Endereço público (com https) quando estiver atrás do NPM. Vazio em uso local.
DASHBOARD_PUBLIC_URL=
DASHBOARD_USERNAME=admin
# Gere: openssl rand -hex 16
DASHBOARD_PASSWORD=
# Mantém o login após reinícios. Gere: openssl rand -base64 32
DASHBOARD_SESSION_SECRET=

# --- API compatível com OpenAI (opcional) -------------------------------------
# Vazio = desligada. Para ligar: openssl rand -hex 32
API_SERVER_KEY=
