# =============================================================================
# Ânima Eros — configuração do ambiente
# Copie para .env (make init) e ajuste conforme o servidor. O .env não é versionado.
# =============================================================================

# Nome da aplicação: usado no container, nas imagens e nas pastas /srv/*.
# No Nginx Proxy Manager, aponte para http://<APP_NAME>:9119 (dashboard), :9120 (Webapp) e :8642 (API).
APP_NAME=anima-eros

# --- Pacote do Design System (GitHub Packages) ---------------------------------
# Token do GitHub (classic, escopo read:packages): o build instala @anima-solutions/design-system.
# Obrigatório para make build e make deploy.
# - Na sua máquina: prefira o token pessoal no perfil do shell e deixe esta linha comentada.
#   Descomentada, ela substitui o valor do shell.
# - No servidor: token da conta de serviço, aqui no .env.
# NODE_AUTH_TOKEN=

# --- Endereços públicos (com https, sem barra no fim) -------------------------
DASHBOARD_URL=https://eros.animahub.ai
WEBAPP_URL=https://app.eros.animahub.ai

# --- Login (dashboard e Webapp) ----------------------------------------------
DASHBOARD_USERNAME=admin
# Gere com: openssl rand -hex 16
DASHBOARD_PASSWORD=
# Mantém o login após reinícios. Gere com: make secret
DASHBOARD_SESSION_SECRET=

# --- API compatível com OpenAI (opcional) -------------------------------------
# Vazio = desligada. Para ligar: make secret
API_SERVER_KEY=

# --- Rede --------------------------------------------------------------------
# Rede Docker compartilhada com o Nginx Proxy Manager (externa, criada pelo proxy).
PROXY_NETWORK=anima_proxymanager_shared_network
# Portas do ambiente de desenvolvimento (make dev), só em 127.0.0.1
DEV_DASHBOARD_PORT=9119
DEV_WEBAPP_PORT=9120

# --- Recursos ------------------------------------------------------------------
MEM_LIMIT=8G
CPU_LIMIT=2.0

# --- Dono dos arquivos de dados no host (id -u / id -g) -------------------------
HERMES_UID=1000
HERMES_GID=1000

# --- Estrutura de pastas do servidor ----------------------------------------
SRV_ROOT=/srv
STACK_DIR=${SRV_ROOT}/stacks/${APP_NAME}
APPDATA_DIR=${SRV_ROOT}/appdata/${APP_NAME}
BACKUP_DIR=${SRV_ROOT}/backups/${APP_NAME}
BACKUP_KEEP=7
# Dados do ambiente de desenvolvimento (make dev)
DEV_DATA_DIR=./data

# --- Diversos ----------------------------------------------------------------
IMAGE_TAG=latest
TZ=America/Sao_Paulo
